# Optional: generated answers (otherwise the service returns the best passage, "extractive" mode)
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
JUDGE_MODEL=qwen/qwen3.8-27b

# Optional: Pinecone instead of local FAISS
VECTOR_BACKEND=faiss
PINECONE_API_KEY=
PINECONE_INDEX=enterprise-kb

MIN_SCORE=0.25
TOP_K=4
